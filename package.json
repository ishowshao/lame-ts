{
  "name": "lame-ts",
  "version": "0.1.0-rc.1",
  "description": "Zero-dependency TypeScript port of the libmp3lame 3.100 MP3 encoder, bit-exact with the reference C implementation",
  "license": "LGPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishowshao/lame-ts.git"
  },
  "homepage": "https://github.com/ishowshao/lame-ts#readme",
  "bugs": {
    "url": "https://github.com/ishowshao/lame-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "lame-ts": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "release:verify": "node scripts/verify-release-package.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mp3",
    "lame",
    "libmp3lame",
    "encoder",
    "audio",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
